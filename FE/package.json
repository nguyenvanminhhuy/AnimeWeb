{
  "name": "anime-web-fe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm run format:check && pnpm run typecheck && vite build",
